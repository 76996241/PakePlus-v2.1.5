  <!-- 中台指令 -->
  <!--MonitorOn:TYPE:MODE 开启监控，MODE:监控模式：
     0：RJ45自动模式
     1：RJ45手动模式，Web请求模式
     2：GPIB自动模式
     3:  GPIB手动模式，Web请求模式
     4:  串口自动模式
     5:  串口手动模式，Web请求模式

  众望达开启监控：
	 deli@W2M@MonitorOn:MODE TASK_ID   dev_sn:0080000800003420   #TASK_ID:任务ID，MODE：目前是4（串口自动模式）

  MonitorCmd0，不需要设备回复 ； MonitorCmd1，需要设备回复  ； MonitorCmd，需不需要设备回复看指令中是否有？
  -->
  <protocol id="100" type="set"><!--停止监控 -->
    <content>MonitorOff</content>
    <arg receive="false" type="string" bytes="1" count="1"></arg>
  </protocol>
  <protocol id="110" type="set"><!-- -->
    <content>MonitorOn:0</content>
    <arg receive="false" type="string" bytes="1" count="1"></arg>
  </protocol>
